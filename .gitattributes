# Fuerza LF en scripts/config Linux — evita que CRLF de Windows corrompa
# `#!/bin/bash` (bad interpreter) o rompa plymouth/systemd/dnsmasq.
*.sh          text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.conf        text eol=lf
*.plymouth    text eol=lf
*.script      text eol=lf
*.nmconnection text eol=lf
